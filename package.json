{
  "name": "pixelsentinel-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter=!@pixelsentinel/web build && pnpm --filter=@pixelsentinel/web build",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "test:android:live": "pnpm build && PIXELSENTINEL_RUN_ANDROID_LIVE=1 vitest run packages/core/test/android-live.test.ts",
    "typecheck": "pnpm -r --filter=!@pixelsentinel/android-shell exec tsc --noEmit",
    "pixelsentinel": "tsx packages/cli/src/bin.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
